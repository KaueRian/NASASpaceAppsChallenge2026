{
  "name": "earthtrend-detective",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cf": "npm run build && wrangler dev",
    "build": "vite build",
    "build:presets": "node --experimental-strip-types scripts/build-presets.ts",
    "db:migrate:local": "wrangler d1 execute earthtrend-db --local --file=./d1/schema.sql",
    "db:migrate:remote": "wrangler d1 execute earthtrend-db --remote --file=./d1/schema.sql",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
