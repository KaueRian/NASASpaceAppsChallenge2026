{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nasaspaceappschallenge2026",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "geotrend.earth",
      "custom_domain": true,
      "previews_enabled": false
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GEMINI_MODEL": "auto"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "earthtrend-db",
      "database_id": "c271e33e-e666-4678-b4a1-60b2fc829471"
    }
  ],
  "previews": {
    "vars": {
      "GEMINI_MODEL": "auto"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "earthtrend-db",
        "database_id": "c271e33e-e666-4678-b4a1-60b2fc829471"
      }
    ]
  }
}
